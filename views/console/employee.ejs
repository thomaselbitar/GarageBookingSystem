<%- include('../partials/console-start', {
    documentTitle: employee.fullName + ' | Garage Booking',
    navActive: 'employees',
    pageHeading: employee.fullName
}) %>

            <a class="back-link" href="<%= console.base %>/employees?type=<%= employee.role %>">
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Back
            </a>

            <div class="page-toolbar">
                <div class="section-head">
                    <div>
                        <h2>Employee account</h2>
                        <p>Account details stay fixed. You can change the password, turn the account on and off, or delete it.</p>
                    </div>
                </div>
            </div>

            <section class="staff-panel">
                <% if (formError) { %>
                    <p class="form-alert" role="alert"><%= formError %></p>
                <% } %>

                <form class="staff-form" action="<%= console.base %>/employees/<%= employee.id %>/password" method="POST" autocomplete="off">
                    <div class="detail-grid">
                        <div class="field">
                            <label for="fullName">Full name</label>
                            <input id="fullName" type="text" value="<%= employee.fullName %>" readonly>
                        </div>
                        <div class="field">
                            <label for="username">Username</label>
                            <input id="username" type="text" value="<%= employee.username %>" readonly>
                        </div>
                        <div class="field">
                            <label for="role">Role</label>
                            <input id="role" type="text" value="<%= roleLabel %>" readonly>
                        </div>
                        <div class="field">
                            <span class="field-label" id="status-label">Status</span>
                            <button
                                class="status-switch <%= employee.isActive ? 'is-on' : '' %>"
                                type="button"
                                id="status-toggle"
                                aria-labelledby="status-label"
                                aria-pressed="<%= employee.isActive ? 'true' : 'false' %>"
                            >
                                <span class="status-switch-track" aria-hidden="true"><span class="status-switch-knob"></span></span>
                                <span class="status-switch-text"><%= employee.isActive ? 'Active' : 'Inactive' %></span>
                            </button>
                        </div>
                        <div class="field">
                            <label for="password">New password</label>
                            <div class="password-wrap">
                                <input id="password" name="password" type="password" autocomplete="new-password" required>
                                <button class="toggle-pass" type="button" aria-label="Show password">Show</button>
                            </div>
                        </div>
                        <div class="field">
                            <label for="confirmPassword">Confirm password</label>
                            <div class="password-wrap">
                                <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required>
                                <button class="toggle-pass" type="button" aria-label="Show password confirmation">Show</button>
                            </div>
                        </div>
                    </div>
                    <div class="employee-actions">
                        <button class="staff-submit" type="submit">Update password</button>
                        <button class="staff-submit is-danger" type="button" id="open-delete">Delete</button>
                    </div>
                </form>
            </section>

<%- include('../partials/console-end') %>
    <div class="success-popup" id="delete-popup" hidden role="dialog" aria-modal="true" aria-labelledby="delete-popup-title">
        <div class="success-popup-card">
            <h2 id="delete-popup-title">Delete account</h2>
            <p><%= employee.fullName %> will be removed and will not be able to log in.</p>
            <form action="<%= console.base %>/employees/<%= employee.id %>/delete" method="POST">
                <div class="popup-actions">
                    <button class="popup-cancel" type="button" id="delete-cancel">Cancel</button>
                    <button class="staff-submit is-danger" type="submit">Delete</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        const openDelete = document.querySelector('#open-delete');
        const deletePopup = document.querySelector('#delete-popup');
        const deleteCancel = document.querySelector('#delete-cancel');

        if (openDelete && deletePopup) {
            openDelete.addEventListener('click', () => {
                deletePopup.hidden = false;
            });

            deleteCancel.addEventListener('click', () => {
                deletePopup.hidden = true;
            });

            deletePopup.addEventListener('click', (event) => {
                if (event.target === deletePopup) deletePopup.hidden = true;
            });
        }
    </script>
    <div class="success-popup" id="status-popup" hidden role="dialog" aria-modal="true" aria-labelledby="status-popup-title">
        <div class="success-popup-card">
            <h2 id="status-popup-title">Deactivate account</h2>
            <p id="status-popup-text">This employee will not be able to log in until the account is activated again.</p>
            <form action="<%= console.base %>/employees/<%= employee.id %>/status" method="POST">
                <input type="hidden" name="active" id="status-value" value="false">
                <div class="popup-actions">
                    <button class="popup-cancel" type="button" id="status-cancel">Cancel</button>
                    <button class="staff-submit" type="submit" id="status-confirm">Deactivate</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        const statusToggle = document.querySelector('#status-toggle');
        const statusPopup = document.querySelector('#status-popup');
        const statusTitle = document.querySelector('#status-popup-title');
        const statusText = document.querySelector('#status-popup-text');
        const statusValue = document.querySelector('#status-value');
        const statusConfirm = document.querySelector('#status-confirm');
        const statusCancel = document.querySelector('#status-cancel');

        if (statusToggle && statusPopup) {
            statusToggle.addEventListener('click', () => {
                const turningOff = statusToggle.getAttribute('aria-pressed') === 'true';
                statusValue.value = turningOff ? 'false' : 'true';
                statusTitle.textContent = turningOff ? 'Deactivate account' : 'Activate account';
                statusText.textContent = turningOff
                    ? 'This employee will not be able to log in until the account is activated again.'
                    : 'This employee will be able to log in again.';
                statusConfirm.textContent = turningOff ? 'Deactivate' : 'Activate';
                statusConfirm.classList.toggle('is-danger', turningOff);
                statusPopup.hidden = false;
            });

            statusCancel.addEventListener('click', () => {
                statusPopup.hidden = true;
            });

            statusPopup.addEventListener('click', (event) => {
                if (event.target === statusPopup) statusPopup.hidden = true;
            });
        }
    </script>
    <% if (deleteError) { %>
        <div class="success-popup" id="delete-failed-popup" role="dialog" aria-modal="true" aria-labelledby="delete-failed-title">
            <div class="success-popup-card">
                <h2 id="delete-failed-title">Could not delete account</h2>
                <p><%= deleteError %></p>
                <button class="staff-submit popup-ok" type="button" id="close-delete-failed">OK</button>
            </div>
        </div>
        <script>
            const deleteFailedPopup = document.querySelector('#delete-failed-popup');
            const closeDeleteFailed = document.querySelector('#close-delete-failed');
            if (deleteFailedPopup && closeDeleteFailed) {
                closeDeleteFailed.addEventListener('click', () => deleteFailedPopup.remove());
                deleteFailedPopup.addEventListener('click', (event) => {
                    if (event.target === deleteFailedPopup) deleteFailedPopup.remove();
                });
            }
        </script>
    <% } %>
    <% if (passwordUpdated) { %>
        <div class="success-popup" id="password-popup" role="dialog" aria-modal="true" aria-labelledby="password-updated-title">
            <div class="success-popup-card">
                <h2 id="password-updated-title">Password updated</h2>
                <p>Share the new password securely with the employee.</p>
                <button class="staff-submit" type="button" id="close-success">OK</button>
            </div>
        </div>
        <script>
            const passwordPopup = document.querySelector('#password-popup');
            const closeSuccess = document.querySelector('#close-success');
            if (passwordPopup && closeSuccess) {
                closeSuccess.addEventListener('click', () => passwordPopup.remove());
                passwordPopup.addEventListener('click', (event) => {
                    if (event.target === passwordPopup) passwordPopup.remove();
                });
            }
        </script>
    <% } %>
    <%- include('../partials/password-toggle') %>
    <%- include('../partials/form-validate') %>
<%- include('../partials/console-close') %>
