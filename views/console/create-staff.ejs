<%- include('../partials/console-start', {
    documentTitle: 'Create Staff Account | Garage Booking',
    navActive: 'staff',
    pageHeading: 'Create staff account'
}) %>

            <section class="welcome-banner">
                <h2>Add a staff account</h2>
                <p>Choose the employee name and role. The username and temporary password are generated for you.</p>
            </section>

            <section class="staff-panel">
                <% if (formError) { %>
                    <p class="form-alert" role="alert"><%= formError %></p>
                <% } %>

                <form class="staff-form" action="<%= console.base %>/staff" method="POST" autocomplete="off">
                    <div class="staff-form-grid">
                        <div class="field">
                            <label for="fullName">Full name</label>
                            <input
                                type="text"
                                id="fullName"
                                name="fullName"
                                maxlength="100"
                                autocomplete="name"
                                required
                                value="<%= formValues.fullName %>"
                            >
                        </div>

                        <div class="field">
                            <label for="role">Role</label>
                            <select id="role" name="role" required>
                                <% const selectedRole = staffRoles.some((staffRole) => staffRole.value === formValues.role); %>
                                <option value="" <%= selectedRole ? '' : 'selected' %>>Select a role</option>
                                <% staffRoles.forEach((staffRole) => { %>
                                    <option value="<%= staffRole.value %>" <%= formValues.role === staffRole.value ? 'selected' : '' %>><%= staffRole.label %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="staff-actions">
                            <span class="staff-actions-label" aria-hidden="true">&nbsp;</span>
                            <div class="staff-actions-row">
                                <button class="popup-cancel" type="button" id="cancel-staff">Cancel</button>
                                <button class="staff-submit" type="submit">Create account</button>
                            </div>
                        </div>
                    </div>
                    <p class="form-help">A username and temporary password are created automatically. You will see them once, immediately after the account is saved.</p>
                </form>
            </section>

<%- include('../partials/console-end') %>
    <div class="success-popup" id="cancel-popup" hidden role="dialog" aria-modal="true" aria-labelledby="cancel-popup-title">
        <div class="success-popup-card">
            <h2 id="cancel-popup-title">Leave this page?</h2>
            <p>The name and role you entered will not be saved.</p>
            <div class="popup-actions">
                <button class="popup-cancel" type="button" id="cancel-stay">Keep editing</button>
                <a class="staff-submit" href="<%= console.base %>/employees">Leave</a>
            </div>
        </div>
    </div>
    <script>
        const cancelStaff = document.querySelector('#cancel-staff');
        const cancelPopup = document.querySelector('#cancel-popup');
        const cancelStay = document.querySelector('#cancel-stay');
        const fullName = document.querySelector('#fullName');
        const role = document.querySelector('#role');

        const formIsEmpty = () => !fullName.value.trim() && !role.value;

        if (cancelStaff && cancelPopup) {
            cancelStaff.addEventListener('click', () => {
                if (formIsEmpty()) {
                    window.location.href = '<%= console.base %>/employees';
                    return;
                }

                cancelPopup.hidden = false;
            });

            cancelStay.addEventListener('click', () => {
                cancelPopup.hidden = true;
            });

            cancelPopup.addEventListener('click', (event) => {
                if (event.target === cancelPopup) cancelPopup.hidden = true;
            });
        }
    </script>
    <%- include('../partials/form-validate') %>
<%- include('../partials/console-close') %>
