<%- include('../partials/console-start', {
    documentTitle: customer.fullName + ' | Garage Booking',
    navActive: 'customers',
    pageHeading: customer.fullName
}) %>

            <a class="back-link" href="<%= console.base %>/customers">
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Back
            </a>

            <div class="page-toolbar">
                <div class="section-head">
                    <div>
                        <h2>Customer account</h2>
                        <p>Account details stay fixed. You can ban or unban this customer.</p>
                    </div>
                </div>
            </div>

            <section class="staff-panel staff-form">
                <div class="detail-grid">
                    <div class="field">
                        <label for="fullName">Full name</label>
                        <input id="fullName" type="text" value="<%= customer.fullName %>" readonly>
                    </div>
                    <div class="field">
                        <label for="email">Email</label>
                        <input id="email" type="text" value="<%= customer.email %>" readonly>
                    </div>
                    <div class="field">
                        <label for="joinedOn">Joined</label>
                        <input id="joinedOn" type="text" value="<%= customer.joinedOn %>" readonly>
                    </div>
                    <div class="field">
                        <span class="field-label" id="status-label">Status</span>
                        <button
                            class="status-switch <%= customer.isActive ? 'is-on' : '' %>"
                            type="button"
                            id="status-toggle"
                            aria-labelledby="status-label"
                            aria-pressed="<%= customer.isActive ? 'true' : 'false' %>"
                        >
                            <span class="status-switch-track" aria-hidden="true"><span class="status-switch-knob"></span></span>
                            <span class="status-switch-text"><%= customer.isActive ? 'Active' : 'Banned' %></span>
                        </button>
                    </div>
                </div>
            </section>

<%- include('../partials/console-end') %>
    <div class="success-popup" id="status-popup" hidden role="dialog" aria-modal="true" aria-labelledby="status-popup-title">
        <div class="success-popup-card">
            <h2 id="status-popup-title">Ban customer</h2>
            <p id="status-popup-text">This customer will not be able to log in until the account is unbanned.</p>
            <form action="<%= console.base %>/customers/<%= customer.id %>/status" method="POST">
                <input type="hidden" name="active" id="status-value" value="false">
                <div class="popup-actions">
                    <button class="popup-cancel" type="button" id="status-cancel">Cancel</button>
                    <button class="staff-submit" type="submit" id="status-confirm">Ban</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        const statusToggle = document.querySelector('#status-toggle');
        const statusPopup = document.querySelector('#status-popup');
        const statusTitle = document.querySelector('#status-popup-title');
        const statusText = document.querySelector('#status-popup-text');
        const statusValue = document.querySelector('#status-value');
        const statusConfirm = document.querySelector('#status-confirm');
        const statusCancel = document.querySelector('#status-cancel');

        if (statusToggle && statusPopup) {
            statusToggle.addEventListener('click', () => {
                const turningOff = statusToggle.getAttribute('aria-pressed') === 'true';
                statusValue.value = turningOff ? 'false' : 'true';
                statusTitle.textContent = turningOff ? 'Ban customer' : 'Unban customer';
                statusText.textContent = turningOff
                    ? 'This customer will not be able to log in until the account is unbanned.'
                    : 'This customer will be able to log in again.';
                statusConfirm.textContent = turningOff ? 'Ban' : 'Unban';
                statusConfirm.classList.toggle('is-danger', turningOff);
                statusPopup.hidden = false;
            });

            statusCancel.addEventListener('click', () => {
                statusPopup.hidden = true;
            });

            statusPopup.addEventListener('click', (event) => {
                if (event.target === statusPopup) statusPopup.hidden = true;
            });
        }
    </script>
<%- include('../partials/console-close') %>
