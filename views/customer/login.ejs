<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title>Customer Login | AutoHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-page">
    <main class="login-shell">
        <%- include('../partials/login-brand', { caption: 'Book with ease. Drive with confidence.' }) %>

        <section class="login-panel">
            <h2>Log in to Auto<span>Hub</span></h2>
            <p class="lede">Sign in with your email and password to book a service.</p>

            <% if (success) { %>
                <p class="alert success" role="status"><%= success %></p>
            <% } %>
            <% if (banned) { %>
                <p class="alert" role="alert">You are banned for violating our policy. Need help <a href="tel:+96181690063">+961 81690063</a></p>
            <% } else if (error) { %>
                <p class="alert" role="alert"><%= error %></p>
            <% } %>

            <form action="/customer/login" method="POST" novalidate>
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" value="<%= email || '' %>" autocomplete="email" required>
                    <p class="field-error" role="alert"></p>
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <div class="password-wrap">
                        <input type="password" id="password" name="password" autocomplete="current-password" required>
                        <button class="toggle-pass" type="button" aria-label="Show password">Show</button>
                    </div>
                    <p class="field-error" role="alert"></p>
                </div>
                <button class="btn-login" type="submit">Login</button>
            </form>

            <div class="auth-links">
                <a href="/customer/forgot-password">Forgot your password?</a>
                <a href="/customer/signup">New here? Create a customer account</a>
            </div>
        </section>
    </main>
    <%- include('../partials/password-toggle') %>
    <%- include('../partials/form-validate') %>
</body>
</html>
