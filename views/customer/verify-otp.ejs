<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title><%= title %> | AutoHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-page">
    <main class="login-shell">
        <%- include('../partials/login-brand', { caption: 'Book with ease. Drive with confidence.' }) %>

        <section class="login-panel">
            <h2><%= title %></h2>
            <p class="lede"><%= lede %> <% if (typeof email !== 'undefined' && email) { %>Sent to <%= email %>.<% } %></p>

            <% if (success) { %>
                <p class="alert success" role="status"><%= success %></p>
            <% } %>
            <% if (error) { %>
                <p class="alert" role="alert"><%= error %></p>
            <% } %>

            <form action="<%= action %>" method="POST" novalidate>
                <div class="field">
                    <label for="otp">Verification code</label>
                    <input class="otp-input" type="text" id="otp" name="otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required>
                    <p class="field-error" role="alert"></p>
                </div>
                <button class="btn-login" type="submit">Verify code</button>
            </form>

            <form action="<%= resendAction %>" method="POST">
                <button
                    class="btn-secondary"
                    id="resend-btn"
                    type="submit"
                    data-wait="<%= resendWait || 0 %>"
                    <%= (resendWait || 0) > 0 ? 'disabled' : '' %>
                >
                    <% if ((resendWait || 0) > 0) { %>
                        Resend in <span id="resend-count"><%= resendWait %></span>s
                    <% } else { %>
                        Resend code
                    <% } %>
                </button>
            </form>
        </section>
    </main>
    <script>
        const resendBtn = document.getElementById('resend-btn');
        if (resendBtn) {
            let remaining = Number(resendBtn.dataset.wait || 0);
            const tick = () => {
                if (remaining <= 0) {
                    resendBtn.disabled = false;
                    resendBtn.textContent = 'Resend code';
                    return;
                }
                resendBtn.disabled = true;
                resendBtn.innerHTML = 'Resend in <span id="resend-count">' + remaining + '</span>s';
                remaining -= 1;
                setTimeout(tick, 1000);
            };
            if (remaining > 0) {
                tick();
            }
        }
    </script>
    <%- include('../partials/form-validate') %>
</body>
</html>
