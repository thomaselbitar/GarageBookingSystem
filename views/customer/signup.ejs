<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title>Customer Sign Up | AutoHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body class="login-page">
    <main class="login-shell">
        <%- include('../partials/login-brand', { caption: 'Book with ease. Drive with confidence.' }) %>

        <section class="login-panel">
            <h2>Sign up to Auto<span>Hub</span></h2>
            <p class="lede">Enter your email and we will send a 6-digit code to verify it.</p>

            <% if (error) { %>
                <p class="alert" role="alert"><%= error %></p>
            <% } %>

            <form action="/customer/signup" method="POST" novalidate>
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" value="<%= email || '' %>" autocomplete="email" required>
                    <p class="field-error" role="alert"></p>
                </div>
                <button class="btn-login" type="submit">Send verification code</button>
            </form>

            <div class="auth-links">
                <a href="/customer/login">Already have an account? Log in</a>
            </div>
        </section>
    </main>
    <%- include('../partials/form-validate') %>
</body>
</html>
