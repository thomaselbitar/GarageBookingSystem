<script>document.documentElement.classList.add('js-nav');</script>
<div class="sidebar-slot">
    <button class="nav-toggle" type="button" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Open menu">
        <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <div class="nav-overlay" aria-hidden="true"></div>
    <aside class="sidebar" id="admin-sidebar">
        <div class="logo">
            <img class="brand-logo" src="/images/logo.png" alt="AutoHub">
            <span><%= console.title %></span>
        </div>
        <button class="nav-close" type="button" aria-label="Close menu">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
        </button>

        <nav class="nav" aria-label="<%= console.navLabel %>">
            <a href="<%= console.base %>/dashboard" class="<%= navActive === 'overview' ? 'active' : '' %>">Overview</a>
            <a href="<%= console.base %>/employees" class="<%= navActive === 'employees' || navActive === 'staff' ? 'active' : '' %>">Manage employees</a>
            <a href="<%= console.base %>/customers" class="<%= navActive === 'customers' ? 'active' : '' %>">Manage customers</a>
        </nav>

        <div class="sidebar-bottom">
            <% if (typeof user !== 'undefined' && user && user.fullName) { %>
                <div class="sidebar-user">
                    <div class="avatar"><%= user.fullName.charAt(0).toUpperCase() %></div>
                    <div>
                        <strong><%= user.fullName %></strong>
                        <small><%= console.roleLabel %></small>
                    </div>
                </div>
            <% } %>

            <form class="sidebar-foot" action="/logout" method="POST">
                <button class="logout-btn" type="submit">Logout</button>
            </form>
        </div>
    </aside>
</div>
<script src="/js/admin-nav.js" defer></script>
