    <div class="customer-modal" id="vehicle-modal" hidden>
        <div class="customer-modal-card" role="dialog" aria-modal="true" aria-labelledby="vehicle-modal-title">
            <div class="customer-modal-head">
                <h2 id="vehicle-modal-title">Add Vehicle</h2>
                <button class="customer-modal-close" id="vehicle-modal-close" type="button" aria-label="Close">
                    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                        <path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <form class="customer-form" id="vehicle-form" action="/customer/vehicles" method="POST" enctype="multipart/form-data" novalidate data-max-year="<%= maxYear %>">
                <p class="customer-form-alert" id="vehicle-form-error" hidden></p>
                <div class="customer-vehicle-fields">
                    <div class="field">
                        <label for="vehicle-make">Make</label>
                        <input id="vehicle-make" name="make" type="text" maxlength="50" autocomplete="off" required>
                    </div>
                    <div class="field">
                        <label for="vehicle-model">Model</label>
                        <input id="vehicle-model" name="model" type="text" maxlength="50" autocomplete="off" required>
                    </div>
                    <div class="field">
                        <label for="vehicle-year">Year</label>
                        <input id="vehicle-year" name="year" type="text" inputmode="numeric" maxlength="4" autocomplete="off" required>
                    </div>
                    <div class="field">
                        <label for="vehicle-color">Color</label>
                        <select id="vehicle-color" name="color" required>
                            <option value="">Choose a color</option>
                            <% vehicleColors.forEach((color) => { %>
                                <option value="<%= color %>"><%= color %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="field field-wide">
                        <label for="vehicle-plate">License plate</label>
                        <input id="vehicle-plate" name="licensePlate" type="text" maxlength="30" autocomplete="off" spellcheck="false" placeholder="B 123456" required>
                        <p class="customer-field-hint">One letter and 2 to 7 digits, such as B 123456.</p>
                    </div>
                    <div class="field field-wide">
                        <label for="vehicle-image">Vehicle image</label>
                        <input id="vehicle-image" name="image" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
                        <p class="customer-field-hint" id="vehicle-image-hint">JPG, PNG, or WEBP. Maximum 5 MB. Required when adding a vehicle.</p>
                        <div class="customer-vehicle-preview" id="vehicle-preview" hidden>
                            <img id="vehicle-preview-img" alt="Selected vehicle image">
                            <p id="vehicle-preview-label"></p>
                            <button class="customer-vehicle-secondary" id="vehicle-image-remove" type="button" hidden>Remove image</button>
                        </div>
                    </div>
                </div>
                <div class="customer-modal-actions">
                    <button class="customer-vehicle-secondary" id="vehicle-cancel" type="button">Cancel</button>
                    <button class="customer-submit" id="vehicle-submit" type="submit">Add Vehicle</button>
                </div>
            </form>
        </div>
    </div>

    <div class="customer-modal" id="vehicle-cancel-modal" hidden>
        <div class="customer-modal-card customer-modal-card-narrow" role="dialog" aria-modal="true" aria-labelledby="vehicle-cancel-title">
            <h2 id="vehicle-cancel-title">Discard this vehicle?</h2>
            <p id="vehicle-cancel-text">The details you entered will not be saved.</p>
            <div class="customer-modal-actions">
                <button class="customer-vehicle-secondary" id="vehicle-cancel-stay" type="button">Keep editing</button>
                <button class="customer-vehicle-danger" id="vehicle-cancel-confirm" type="button">Discard</button>
            </div>
        </div>
    </div>

    <div class="customer-modal" id="vehicle-delete-modal" hidden>
        <div class="customer-modal-card customer-modal-card-narrow" role="dialog" aria-modal="true" aria-labelledby="vehicle-delete-title">
            <h2 id="vehicle-delete-title">Delete vehicle</h2>
            <p id="vehicle-delete-text"></p>
            <form id="vehicle-delete-form" method="POST" action="">
                <div class="customer-modal-actions">
                    <button class="customer-vehicle-secondary" id="vehicle-delete-cancel" type="button">Cancel</button>
                    <button class="customer-vehicle-danger" type="submit">Delete</button>
                </div>
            </form>
        </div>
    </div>
