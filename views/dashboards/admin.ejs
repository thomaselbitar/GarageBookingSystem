<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title><%= console.pageTitle %> Dashboard | Garage Booking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
    <div class="admin-layout">
        <%- include('../partials/admin-sidebar', { navActive: 'overview' }) %>

        <main class="workspace">
            <header class="topbar">
                <div>
                    <p class="eyebrow"><%= console.eyebrow %></p>
                    <h1>Garage booking system</h1>
                </div>
                <div class="user-chip">
                    <div class="avatar"><%= user.fullName.charAt(0).toUpperCase() %></div>
                    <div>
                        <strong><%= user.fullName %></strong>
                        <small><%= console.roleLabel %></small>
                    </div>
                </div>
            </header>

            <section class="welcome-banner">
                <h2>Welcome back, <%= user.fullName %>.</h2>
                <p>You are logged in as <%= console.roleLabel %>. Use this console to keep crews, customers, and bookings in sync.</p>
            </section>

            <section class="stats" aria-label="Dashboard overview">
                <article class="stat-card" style="--accent:#ee7113">
                    <p>Open bookings</p>
                    <strong>18</strong>
                </article>
                <article class="stat-card" style="--accent:#3ecfbf">
                    <p>Active staff</p>
                    <strong>12</strong>
                </article>
                <article class="stat-card" style="--accent:#6ea8ff">
                    <p>Customers</p>
                    <strong>64</strong>
                </article>
                <article class="stat-card" style="--accent:#b08cff">
                    <p>Services live</p>
                    <strong>5</strong>
                </article>
            </section>
        </main>
    </div>
</body>
</html>
