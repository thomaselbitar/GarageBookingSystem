<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title>Employee Dashboard | Garage Booking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/employee.css">
    <script>document.documentElement.classList.add('employee-js-nav');</script>
</head>
<body class="employee-page">
    <% const employeeName = user && user.fullName ? user.fullName : ''; %>
    <% const employeeInitial = (employeeName || 'E').charAt(0).toUpperCase(); %>
    <div class="employee-shell">
        <div class="employee-sidebar-slot">
            <button class="employee-nav-toggle" type="button" aria-controls="employee-sidebar" aria-expanded="false" aria-label="Open menu">
                <span class="employee-nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
            </button>
            <div class="employee-nav-overlay" aria-hidden="true"></div>
            <aside class="employee-sidebar" id="employee-sidebar" data-menu-label="Employee menu">
                <div class="employee-brand">
                    <img src="/images/logo.png" alt="AutoHub">
                    <span>Employee portal</span>
                </div>
                <button class="employee-nav-close" type="button" aria-label="Close menu">
                    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                        <path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </button>

                <nav class="employee-nav" aria-label="Employee">
                    <a href="/employee/dashboard" class="active" aria-current="page">Overview</a>
                </nav>

                <div class="employee-sidebar-bottom">
                    <div class="employee-sidebar-user">
                        <div class="employee-avatar" aria-hidden="true"><%= employeeInitial %></div>
                        <div>
                            <strong><%= employeeName || 'Employee' %></strong>
                            <small><%= roleLabel %></small>
                        </div>
                    </div>
                    <form action="/logout" method="POST">
                        <button class="employee-logout" type="submit">Logout</button>
                    </form>
                </div>
            </aside>
        </div>

        <main class="employee-workspace">
            <header class="employee-topbar">
                <div class="employee-topbar-title">
                    <p class="employee-eyebrow">Employee portal</p>
                    <h1>Employee dashboard</h1>
                </div>
                <div class="employee-user-chip">
                    <div class="employee-avatar" aria-hidden="true"><%= employeeInitial %></div>
                    <div>
                        <strong><%= employeeName || 'Employee' %></strong>
                        <small><%= roleLabel %></small>
                    </div>
                </div>
            </header>

            <section class="employee-welcome">
                <h2>Welcome<%= employeeName ? ', ' + employeeName : '' %>.</h2>
                <p>You are signed in as a <%= roleLabel %>.</p>
            </section>

            <section class="employee-role-card" aria-label="Position">
                <p class="employee-eyebrow">Position</p>
                <h2><%= roleLabel %></h2>
            </section>

            <section class="employee-cards" aria-label="Dashboard overview">
                <article class="employee-card" style="--accent:#ee7113">
                    <div class="employee-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20">
                            <rect x="5" y="3.5" width="14" height="17" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M8.5 9h7M8.5 13h7M8.5 17h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h2>My Tasks</h2>
                    <p>Your assigned tasks will appear here.</p>
                </article>
                <article class="employee-card" style="--accent:#3ecfbf">
                    <div class="employee-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20">
                            <rect x="4" y="5" width="16" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M8 3.5v3M16 3.5v3M4 10h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h2>Schedule</h2>
                    <p>Your work schedule will appear here.</p>
                </article>
                <article class="employee-card" style="--accent:#6ea8ff">
                    <div class="employee-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20">
                            <circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M5.5 19.2c1.4-2.6 3.6-3.9 6.5-3.9s5.1 1.3 6.5 3.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h2>Profile</h2>
                    <p>Your employee information will appear here.</p>
                </article>
            </section>
        </main>
    </div>
    <script src="/js/employee-nav.js" defer></script>
</body>
</html>
